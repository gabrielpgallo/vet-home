# Copy to .env.local and choose new passwords before setup.
POSTGRES_PASSWORD=change-owner-password
APP_DB_PASSWORD=change-app-password
ADMIN_DATABASE_URL=postgresql://vet_owner:change-owner-password@127.0.0.1:55435/vet_domicilio
DATABASE_URL=postgresql://vet_app:change-app-password@127.0.0.1:55435/vet_domicilio
# Local development only. Use AUTH_MODE=google and APP_LOCAL_MODE=false for deployed environments.
APP_LOCAL_MODE=true
APP_ORG_ID=ar-saude-animal

# Explicit development bypass; never enable in a publicly reachable environment.
AUTH_MODE=local
BETTER_AUTH_URL=http://127.0.0.1:3010
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
IAM_INITIAL_ADMIN_EMAIL=irsaudeanimal@gmail.com
